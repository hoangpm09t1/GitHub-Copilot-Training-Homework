{
  "info": {
    "name": "Day 4 - E-Commerce API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{ \"email\": \"admin@example.com\", \"password\": \"Admin@123\" }"
            }
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category (Electronics)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Electronics\" }"
            }
          }
        },
        {
          "name": "Create Sub-Category (Phones)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/categories",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Phones\", \"parentId\": 1 }"
            }
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"iPhone 15\", \"description\": \"Latest Apple smartphone\", \"price\": 999.99, \"stockQuantity\": 50, \"categoryId\": 1 }"
            }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/1"
          }
        },
        {
          "name": "Search Products (all)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=0&size=10",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Products (keyword)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?keyword=iphone&page=0&size=10",
              "query": [
                { "key": "keyword", "value": "iphone" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Products (price range)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?minPrice=100&maxPrice=1000&page=0&size=10",
              "query": [
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "1000" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Search Products (category filter)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?categoryId=1&page=0&size=5",
              "query": [
                { "key": "categoryId", "value": "1" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/products/1",
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"iPhone 15 Pro\", \"price\": 1199.99, \"stockQuantity\": 30 }"
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/products/1"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order (success)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{ \"userId\": 1, \"items\": [{ \"productId\": 1, \"quantity\": 2 }] }"
            }
          }
        },
        {
          "name": "Place Order (out-of-stock - expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/orders",
            "body": {
              "mode": "raw",
              "raw": "{ \"userId\": 1, \"items\": [{ \"productId\": 1, \"quantity\": 99999 }] }"
            }
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "Get Orders by User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/users/1/orders"
          }
        }
      ]
    }
  ]
}
